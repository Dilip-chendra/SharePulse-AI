# SharePulse-AI Backend Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# NEVER expose these keys in frontend code or browser console.

# Gemini API Key (Primary AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Fallback AI Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Clerk Secret Key (Server-side auth verification only)
# Get from https://dashboard.clerk.com → API Keys → Secret keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
